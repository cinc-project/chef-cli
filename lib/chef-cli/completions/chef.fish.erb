
# Fish Shell command-line completions for <%=ChefCLI::Dist::PRODUCT %>

set -l cinc_commands <%= commands.keys.join(' ') %>;

<% commands.each do |command, desc| -%>
complete -c <%= habitat? ? "chef-cli" : "cinc" %> -f -n "not __fish_seen_subcommand_from $cinc_commands" -a <%= command %> -d "<%= desc %>";
<% end -%>
